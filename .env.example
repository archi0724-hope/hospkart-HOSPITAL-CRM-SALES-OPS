# SmartBot / OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Meta WhatsApp Cloud API
# Use the Graph API version shown in your Meta app/dashboard.
WHATSAPP_GRAPH_API_VERSION=v23.0
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=change-this-to-a-long-random-string

# Automation switches
# Scheduled automation uses approved Meta templates only.
WHATSAPP_AUTOMATION_ENABLED=false
# Auto-reply applies only to inbound WhatsApp messages. Keep false until tested.
WHATSAPP_AUTO_REPLY_ENABLED=false

# Local server
# Email follow-ups (use your email provider's SMTP settings)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_FROM_NAME=HOSPkart
EMAIL_AUTOMATION_ENABLED=false

PORT=5000
FLASK_DEBUG=false
# Optional persistent directory for SQLite, admin hash and prepared workbook.
# CRM_DATA_DIR=/path/to/persistent/data
# Run exactly one process with scheduling enabled.
SCHEDULER_ENABLED=true
# When HTTPS terminates at a trusted reverse proxy, configure its peer IP.
# TRUSTED_PROXY=127.0.0.1
# TRUSTED_PROXY_COUNT=1

# QuoteSaarthi catalogue lives in the private persistent data directory.
# QUOTESAARTHI_CATALOG_PATH=/path/to/private/products.csv
QUOTESAARTHI_USE_OLLAMA=false
QUOTESAARTHI_OLLAMA_MODEL=hospkart-bd
